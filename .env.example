# Anthropic API (used by the /chat and /lineup reasoning endpoints)
ANTHROPIC_API_KEY=

# Sleeper API (no key required, base URL is configurable in case Sleeper
# versions their API in the future)
SLEEPER_API_BASE_URL=https://api.sleeper.app/v1

# Current NFL season, used when auto-pulling a user's leagues from Sleeper
NFL_SEASON=2025

# Database (used for roster storage in the next phase)
DATABASE_URL=sqlite:///./fantasy_football.db

# Vector store (used for the RAG pipeline in the next phase)
CHROMA_PERSIST_DIR=./chroma_data
